# Environment variables for Robot Framework tests.
# Copy this file to .env and edit for your target environment.
# Export these values in your shell or configure them in CI before running tests.

# ── Application URLs ──────────────────────────────────────────────────────────
# Defaults point to public demo sites used by the bundled example suites.
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# ── Browser Library / Playwright ──────────────────────────────────────────────
BROWSER=chrome              # chrome | firefox | edge
HEADLESS=false              # true for CI / docker environments
TIMEOUT=15s

# ── Mobile / AppiumLibrary ────────────────────────────────────────────────────
# Keep false for infrastructure-free CI. Set true locally or in a device-lab job.
RUN_MOBILE_TESTS=false
MOBILE_PLATFORM=android     # android | ios
MOBILE_APPIUM_SERVER=http://127.0.0.1:4723
MOBILE_STARTUP_LOCATOR=
MOBILE_TIMEOUT=20s

# Android capabilities
ANDROID_AUTOMATION_NAME=UiAutomator2
ANDROID_PLATFORM_VERSION=
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_APP=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# iOS capabilities
IOS_AUTOMATION_NAME=XCUITest
IOS_PLATFORM_VERSION=
IOS_DEVICE_NAME=iPhone Simulator
IOS_APP=
IOS_BUNDLE_ID=

# ── Runner ────────────────────────────────────────────────────────────────────
# scripts/run_robot_tests.sh uses pabot by default, then reruns failed tests and
# merges rerun output back into results/output.xml.
USE_PABOT=true
PABOT_PROCESSES=4
RESULTS_DIR=results
ROBOT_DASHBOARD_DB=results/robot_results.db
ROBOT_DASHBOARD_HTML=results/dashboard.html

# ── Database ──────────────────────────────────────────────────────────────────
# sqlite   → no server needed; DB_NAME is the file path (default: results/test.db)
# postgresql | mysql | mongodb → fill in the connection details below
DB_TYPE=sqlite
DB_NAME=results/test.db

# PostgreSQL / MySQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=test_user
DB_PASSWORD=test_password

# MongoDB (if DB_TYPE=mongodb)
# DB_HOST=localhost
# DB_PORT=27017

# ── OWASP ZAP passive proxy ───────────────────────────────────────────────────
# Leave empty to skip proxy routing. CI sets this automatically in the ZAP job.
ZAP_PROXY=
ZAP_API_KEY=
