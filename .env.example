# Environment variables for Robot Framework tests
# Copy this file to .env and update with your actual values

# Application URLs
BASE_URL=https://your-app.com
API_BASE_URL=https://api.your-app.com
STAGING_URL=https://staging.your-app.com

# Database connections
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password
DB_TYPE=postgresql  # postgresql, mysql, oracle, mongodb

# MySQL specific (if using MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=test_db
MYSQL_USER=test_user
MYSQL_PASSWORD=test_password

# MongoDB specific (if using MongoDB)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=test_db
MONGO_USER=test_user
MONGO_PASSWORD=test_password

# API Keys and Tokens
API_KEY=your_api_key_here
AUTH_TOKEN=your_auth_token_here

# Test user credentials
TEST_USERNAME=testuser
TEST_PASSWORD=testpass123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass123

# Browser settings
BROWSER=chrome
HEADLESS=false
WINDOW_SIZE=1920x1080

# Test configuration
TIMEOUT=10
IMPLICIT_WAIT=5
RETRY_COUNT=3

# External service URLs
WEBHOOK_URL=https://webhook.site/your-webhook-id
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Security Testing with OWASP ZAP
# Leave empty to disable proxy, set to ZAP proxy URL to enable
ZAP_PROXY=  # Example: http://localhost:8080
ZAP_API_KEY=your_zap_api_key_here

# Feature flags
ENABLE_API_TESTS=true
ENABLE_UI_TESTS=true
ENABLE_DB_TESTS=false
ENABLE_SECURITY_TESTS=false
