[tool.robotidy]
line_length = 120
overwrite = true
diff = true
transform = [
  "DiscardEmptySections",
  "NormalizeNewLines",
  "NormalizeSeparators",
  "OrderSettings",
  "OrderSettingsSection",
  "ReplaceRunKeywordIf",
  "SplitTooLongLine:line_length=120",
  "NormalizeAssignments",
  "NormalizeTags",
]
